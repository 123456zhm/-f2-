.page-container {
  padding: 32rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #f5f7fa 0%, #ffffff 100%);
}

/* 统计卡片 */
.stats-section {
  margin-bottom: 24rpx;
}

.stats-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  justify-content: space-around;
  align-items: center;
  box-shadow: 0 16rpx 48rpx rgba(102, 126, 234, 0.3);
}

.stat-item {
  text-align: center;
}

.stat-number {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.stat-divider {
  width: 2rpx;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.3);
}

/* 历史列表 */
.history-section {
  margin-bottom: 24rpx;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.history-item {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex;
  gap: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
}

.history-item:active {
  transform: scale(0.98);
}

.item-cover {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.cover-badge {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cover-badge.xiaohongshu {
  background: linear-gradient(135deg, #ff2442 0%, #ff6b6b 100%);
}

.cover-badge.douyin {
  background: linear-gradient(135deg, #161823 0%, #2c2c2c 100%);
}

.cover-badge.weibo {
  background: linear-gradient(135deg, #ff8200 0%, #ff5722 100%);
}

.badge-icon {
  font-size: 18rpx;
}

.type-badge {
  position: absolute;
  bottom: 8rpx;
  right: 8rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 8rpx;
  padding: 4rpx 8rpx;
  font-size: 18rpx;
}

.item-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.item-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.item-author {
  font-size: 24rpx;
  color: #667eea;
}

.item-meta {
  display: flex;
  gap: 16rpx;
}

.meta-time {
  font-size: 22rpx;
  color: #999999;
}

.meta-files {
  font-size: 22rpx;
  color: #00c853;
}

.item-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  align-items: center;
}

.action-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.download-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.download-btn:active {
  opacity: 0.9;
}

.delete-btn {
  background: #f5f7fa;
}

.delete-btn:active {
  background: #ff5252;
}

.btn-icon {
  font-size: 24rpx;
  color: #ffffff;
}

.delete-btn .btn-icon {
  color: #999999;
}

.delete-btn:active .btn-icon {
  color: #ffffff;
}

/* 空状态 */
.empty-section {
  padding: 120rpx 0;
}

.empty-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 64rpx 48rpx;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.empty-desc {
  display: block;
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 32rpx;
}

.empty-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  border-radius: 48rpx;
  padding: 24rpx 64rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}

.empty-btn:active {
  opacity: 0.9;
}

/* 底部操作 */
.bottom-section {
  padding: 32rpx 0;
}

.bottom-actions {
  display: flex;
  gap: 24rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  transition: all 0.3s ease;
}

.clear-btn {
  background: #fff5f5;
  color: #ff5252;
  border: 2rpx solid #ff5252;
}

.clear-btn:active {
  background: #ff5252;
  color: #ffffff;
}

.full-width {
  width: 100%;
}

.btn-text {
  font-size: 28rpx;
}

/* 详情弹窗 */
.detail-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  z-index: 9998;
  display: flex;
  align-items: flex-end;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.detail-container {
  width: 100%;
  max-height: 90vh;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  overflow-y: auto;
  animation: slideUp 0.3s ease;
  padding-bottom: env(safe-area-inset-bottom);
}

@keyframes slideUp {
  from { transform: translateY(100%); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.detail-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 2rpx solid #f5f7fa;
  position: sticky;
  top: 0;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 1;
}

.detail-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.detail-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f7fa;
  border-radius: 50%;
  margin-left: 16rpx;
  color: #666666;
  font-size: 28rpx;
}

.detail-close:active {
  background: #e4e8ec;
}

/* 详情封面 */
.detail-cover-section {
  padding: 24rpx 32rpx;
}

.detail-cover {
  position: relative;
  width: 100%;
  height: 400rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.detail-cover .cover-image {
  width: 100%;
  height: 100%;
}

.play-btn-overlay {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 96rpx;
  height: 96rpx;
  background: rgba(0, 0, 0, 0.7);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.play-btn-overlay .play-icon {
  color: #ffffff;
  font-size: 40rpx;
  margin-left: 8rpx;
}

.cover-placeholder {
  width: 100%;
  height: 300rpx;
  background: linear-gradient(135deg, #f5f7fa 0%, #e4e8ec 100%);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-text {
  font-size: 26rpx;
  color: #999999;
}

/* 信息卡片 */
.detail-info-card {
  margin: 0 24rpx;
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 20rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #eeeeee;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #666666;
  font-weight: 500;
}

.info-value {
  font-size: 26rpx;
  color: #333333;
  font-weight: 500;
}

.type-tag {
  padding: 6rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.type-tag.video {
  background: linear-gradient(135deg, #ff5722 0%, #ff9800 100%);
  color: #ffffff;
}

.type-tag.note,
.type-tag.image {
  background: linear-gradient(135deg, #00c853 0%, #69f0ae 100%);
  color: #ffffff;
}

.stats-inline {
  display: flex;
  gap: 16rpx;
}

.stat-item-inline {
  font-size: 24rpx;
  color: #333333;
  font-weight: 500;
}

/* 图片列表 */
.detail-images-section {
  padding: 24rpx 32rpx;
}

.section-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.images-grid-detail {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.image-item-detail {
  position: relative;
  width: calc((100% - 24rpx) / 3);
  height: 180rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.image-thumb-detail {
  width: 100%;
  height: 100%;
}

.image-index-badge {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #ffffff;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 10rpx;
}

/* 操作按钮 */
.detail-actions {
  padding: 24rpx 32rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.action-button {
  width: 100%;
  padding: 24rpx;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.primary-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
}

.primary-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.secondary-btn {
  background: #f5f7fa;
  color: #667eea;
  border: 2rpx solid #667eea;
}

.secondary-btn:active {
  background: #e8ebf0;
}

/* 视频播放器（详情页用） */
.video-player-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.9);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.3s ease;
}

.video-player-container {
  width: 100%;
  max-width: 800rpx;
  background: #000000;
  border-radius: 16rpx;
  overflow: hidden;
  animation: slideUp 0.3s ease;
}

.video-player-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: #1a1a1a;
}

.video-player-title {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 500;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.video-player-close {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 36rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  margin-left: 16rpx;
}

.video-player-close:active {
  background: rgba(255, 255, 255, 0.3);
}

.video-player {
  width: 100%;
  height: 450rpx;
  background: #000000;
}