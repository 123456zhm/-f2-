.page-container {
  padding: 0;
  min-height: 100vh;
  background: linear-gradient(180deg, #f5f7fa 0%, #ffffff 100%);
}

/* Hero区域 */
.hero-section {
  position: relative;
  padding: 48rpx 32rpx;
  margin-bottom: 32rpx;
}

.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 320rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 0 0 48rpx 48rpx;
  z-index: 0;
}

.hero-content {
  position: relative;
  z-index: 1;
  text-align: center;
  padding-top: 32rpx;
}

.hero-title {
  margin-bottom: 24rpx;
}

.title-main {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 4rpx;
}

.title-sub {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 16rpx;
}

.hero-tags {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.hero-stats {
  display: flex;
  justify-content: center;
  align-items: center;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 32rpx 48rpx;
  box-shadow: 0 16rpx 48rpx rgba(102, 126, 234, 0.2);
}

.stat-item {
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #667eea;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

.stat-divider {
  width: 2rpx;
  height: 64rpx;
  background: linear-gradient(180deg, transparent 0%, #e4e8ec 50%, transparent 100%);
  margin: 0 48rpx;
}

/* 支持平台 */
.platform-section {
  padding: 32rpx;
}

.section-header {
  margin-bottom: 24rpx;
}

.section-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
}

.section-desc {
  display: block;
  font-size: 26rpx;
  color: #999999;
  margin-top: 8rpx;
}

.platform-grid {
  display: flex;
  gap: 24rpx;
}

.platform-card {
  flex: 1;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.platform-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 8rpx;
}

.platform-card.xiaohongshu::before {
  background: linear-gradient(90deg, #ff2442 0%, #ff6b6b 100%);
}

.platform-card.douyin::before {
  background: linear-gradient(90deg, #161823 0%, #2c2c2c 100%);
}

.platform-card.weibo::before {
  background: linear-gradient(90deg, #ff8200 0%, #ff5722 100%);
}

.platform-card:active {
  transform: scale(0.95);
}

.platform-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

.platform-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.platform-badge {
  display: inline-block;
  padding: 6rpx 16rpx;
  background: linear-gradient(135deg, #00c853 0%, #69f0ae 100%);
  color: #ffffff;
  font-size: 22rpx;
  border-radius: 16rpx;
  margin-top: 12rpx;
}

/* 功能入口 */
.action-section {
  padding: 32rpx;
}

.action-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  gap: 24rpx;
  transition: all 0.3s ease;
}

.action-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.main-action {
  margin-bottom: 24rpx;
}

.action-icon-wrapper {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-icon {
  font-size: 40rpx;
}

.action-content {
  flex: 1;
}

.action-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.action-desc {
  display: block;
  font-size: 26rpx;
  color: #999999;
  margin-top: 8rpx;
}

.action-arrow {
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arrow-icon {
  color: #ffffff;
  font-size: 24rpx;
}

.action-row {
  display: flex;
  gap: 24rpx;
}

.mini-action {
  flex: 1;
  padding: 24rpx;
}

.mini-action .action-icon-wrapper {
  width: 64rpx;
  height: 64rpx;
}

.mini-action .action-icon {
  font-size: 32rpx;
}

.mini-action .action-title {
  font-size: 28rpx;
}

.mini-action .action-desc {
  font-size: 24rpx;
}

/* 使用教程 */
.tutorial-section {
  padding: 32rpx;
}

.tutorial-steps {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

.tutorial-step {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f5f7fa;
}

.tutorial-step:last-child {
  border-bottom: none;
}

.step-number {
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
}

.step-content {
  flex: 1;
}

.step-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.step-desc {
  display: block;
  font-size: 26rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* 底部 */
.footer-section {
  padding: 48rpx 32rpx;
  text-align: center;
}

.footer-text {
  display: block;
  font-size: 24rpx;
  color: #999999;
  line-height: 1.8;
}