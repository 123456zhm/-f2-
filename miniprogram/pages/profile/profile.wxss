.page-container {
  padding: 32rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #f5f7fa 0%, #ffffff 100%);
}

/* 用户信息 */
.user-section {
  margin-bottom: 32rpx;
}

.user-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 32rpx;
  padding: 40rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 16rpx 48rpx rgba(102, 126, 234, 0.3);
}

.user-avatar {
  position: relative;
  width: 120rpx;
  height: 120rpx;
}

.avatar-image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.avatar-badge {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 32rpx;
  height: 32rpx;
  background: #00c853;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #ffffff;
}

.badge-icon {
  color: #ffffff;
  font-size: 18rpx;
}

.user-info {
  flex: 1;
}

.user-name {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
}

.user-id {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.user-tags {
  margin-top: 12rpx;
}

.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
}

.tag.vip {
  background: linear-gradient(135deg, #ffd700 0%, #ffb700 100%);
  color: #333333;
}

.tag.normal {
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
}

.user-stats {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.stat-row {
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}

.stat-label {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 功能菜单 */
.menu-section {
  margin-bottom: 32rpx;
}

.menu-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 8rpx 0;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  transition: all 0.3s ease;
}

.menu-item:active {
  background: #f5f7fa;
}

.menu-icon-wrapper {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-icon-wrapper.history {
  background: linear-gradient(135deg, #00c853 0%, #69f0ae 100%);
}

.menu-icon-wrapper.feedback {
  background: linear-gradient(135deg, #ff9800 0%, #ffc107 100%);
}

.menu-icon-wrapper.about {
  background: linear-gradient(135deg, #2196f3 0%, #64b5f6 100%);
}

.menu-icon {
  font-size: 32rpx;
}

.menu-content {
  flex: 1;
}

.menu-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.menu-desc {
  display: block;
  font-size: 26rpx;
  color: #999999;
  margin-top: 6rpx;
}

.menu-arrow {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arrow-icon {
  font-size: 32rpx;
  color: #999999;
}

.menu-divider {
  height: 2rpx;
  background: linear-gradient(90deg, transparent 0%, #f5f7fa 50%, transparent 100%);
  margin: 8rpx 32rpx;
}

/* 支持平台 */
.platform-section {
  margin-bottom: 32rpx;
}

.section-header {
  margin-bottom: 16rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.platform-list {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

.platform-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  background: #f5f7fa;
}

.platform-item:last-child {
  margin-bottom: 0;
}

.platform-icon-wrapper {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.platform-icon-wrapper.xiaohongshu {
  background: linear-gradient(135deg, #ff2442 0%, #ff6b6b 100%);
}

.platform-icon-wrapper.douyin {
  background: linear-gradient(135deg, #161823 0%, #2c2c2c 100%);
}

.platform-icon-wrapper.weibo {
  background: linear-gradient(135deg, #ff8200 0%, #ff5722 100%);
}

.platform-icon {
  font-size: 28rpx;
}

.platform-info {
  flex: 1;
}

.platform-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.platform-status {
  display: block;
  font-size: 24rpx;
  color: #00c853;
  margin-top: 4rpx;
}

/* 设置 */
.settings-section {
  margin-bottom: 32rpx;
}

.settings-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 8rpx 0;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  transition: all 0.3s ease;
}

.setting-item:active {
  background: #f5f7fa;
}

.setting-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.setting-icon {
  font-size: 32rpx;
}

.setting-title {
  font-size: 30rpx;
  color: #333333;
}

.setting-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.cache-size {
  font-size: 26rpx;
  color: #999999;
}

.setting-divider {
  height: 2rpx;
  background: linear-gradient(90deg, transparent 0%, #f5f7fa 50%, transparent 100%);
  margin: 8rpx 32rpx;
}

/* 常见问题 */
.faq-section {
  margin-bottom: 32rpx;
}

.faq-list {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

.faq-item {
  padding: 16rpx;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  background: #f5f7fa;
}

.faq-item:last-child {
  margin-bottom: 0;
}

.faq-question {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.faq-icon {
  width: 32rpx;
  height: 32rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
}

.faq-text {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.faq-answer {
  padding: 16rpx;
  margin-top: 12rpx;
  background: #ffffff;
  border-radius: 12rpx;
}

.answer-text {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
}

/* 底部 */
.footer-section {
  padding: 48rpx 0;
  text-align: center;
}

.footer-text {
  display: block;
  font-size: 24rpx;
  color: #999999;
  line-height: 1.8;
}

.footer-links {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.link-item {
  font-size: 24rpx;
  color: #667eea;
}

.link-divider {
  font-size: 24rpx;
  color: #999999;
}

/* 平台设置按钮 */
.platform-setting-btn {
  padding: 8rpx 16rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 8rpx;
}

.setting-btn-text {
  font-size: 22rpx;
  color: #ffffff;
}

/* 设置弹窗 */
.setting-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 80%;
  max-width: 600rpx;
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.modal-close {
  font-size: 40rpx;
  color: #ffffff;
  padding: 8rpx;
}

.modal-body {
  padding: 32rpx;
}

.setting-group {
  margin-bottom: 32rpx;
}

.setting-group:last-child {
  margin-bottom: 0;
}

.setting-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.mode-switch {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 16rpx;
  background: #f5f7fa;
  border-radius: 16rpx;
}

.mode-text {
  font-size: 26rpx;
  color: #999999;
}

.mode-text.active {
  color: #667eea;
  font-weight: 600;
}

.input-row {
  display: flex;
  gap: 16rpx;
}

.setting-input {
  flex: 1;
  padding: 16rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.cookie-input {
  font-size: 22rpx;
}

.save-btn {
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  font-size: 26rpx;
  border-radius: 12rpx;
  border: none;
}

.status-text {
  display: block;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.status-text.success {
  color: #00c853;
}

.status-text.warning {
  color: #ff9800;
}

.hint-text {
  display: block;
  font-size: 22rpx;
  color: #999999;
  margin-top: 8rpx;
}